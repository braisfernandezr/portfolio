---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Portfolio profesional de Desarrollo Backend, Cloud Infrastructure & DevOps." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased selection:bg-sky-500 selection:text-white min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80">
      <nav class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="#" class="font-bold text-lg tracking-tight hover:text-sky-400 transition-colors">
          portfolio<span class="text-sky-500">.</span>dev
        </a>
        <ul class="flex items-center gap-6 text-sm text-slate-400 font-medium">
          <li><a href="#experiencia" class="hover:text-slate-100 transition-colors">Experiencia</a></li>
          <li><a href="#proyectos" class="hover:text-slate-100 transition-colors">Proyectos</a></li>
          <li><a href="#contacto" class="hover:text-slate-100 transition-colors">Contacto</a></li>
        </ul>
      </nav>
    </header>

    <main class="flex-grow max-w-4xl mx-auto px-6 py-12 w-full">
      <slot />
    </main>

    <footer class="border-t border-slate-800/80 py-8 text-center text-xs text-slate-500">
      <p>© {new Date().getFullYear()} — Construido con Astro & Tailwind CSS</p>
    </footer>
  </body>
</html>