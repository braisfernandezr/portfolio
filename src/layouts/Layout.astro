---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Portfolio profesional de Desarrollo Backend, Cloud Infrastructure & DevOps." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased selection:bg-sky-500 selection:text-white min-h-screen flex flex-col">
    <!-- Navbar Responsive -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80">
      <nav class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="#" class="font-bold text-base sm:text-lg tracking-tight hover:text-sky-400 transition-colors">
          brais<span class="text-sky-500">.dev</span>
        </a>
        
        <ul class="flex items-center gap-4 sm:gap-8 text-xs sm:text-sm text-slate-400 font-medium">
          <li><a href="#experiencia" class="hover:text-slate-100 transition-colors">Experiencia</a></li>
          <li><a href="#proyectos" class="hover:text-slate-100 transition-colors">Proyectos</a></li>
          <li><a href="#contacto" class="hover:text-slate-100 transition-colors">Contacto</a></li>
        </ul>
      </nav>
    </header>

    <!-- Main Container Adaptable -->
    <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16 w-full">
      <slot />
    </main>

    <footer class="border-t border-slate-800/80 py-8 text-center text-xs text-slate-500 px-4">
      <p>© {new Date().getFullYear()} Brais Fernández — Construido con Astro & Tailwind CSS</p>
    </footer>
  </body>
</html>