---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio de Brais Fernández Reyes. Desarrollo backend, infraestructura y sistemas distribuidos.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#171716" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="TzyAQ4aWr7p9tSglGDp491APC234ltWrZtPBfrZ-Ke0" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-[#171716] text-[#eee7dc] antialiased selection:bg-[#762f35] selection:text-[#fff8ef]">
    <header class="border-b border-[#45403a]">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 sm:px-8">
        <a
          href="#inicio"
          class="font-serif text-lg tracking-wide text-[#eee7dc] transition-colors hover:text-[#c9a7a0]"
        >
          Brais Fernández Reyes
        </a>

        <div class="flex items-center gap-4 text-xs tracking-wide text-[#b7afa3] sm:gap-7 sm:text-sm">
          <a href="#sobre-mi" class="transition-colors hover:text-[#eee7dc]">Sobre mí</a>
          <a href="#trayectoria" class="hidden transition-colors hover:text-[#eee7dc] sm:inline">Trayectoria</a>
          <a href="#proyectos" class="transition-colors hover:text-[#eee7dc]">Proyectos</a>
          <a href="#contacto" class="transition-colors hover:text-[#eee7dc]">Contacto</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-[#45403a]">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-7 text-xs text-[#8e877d] sm:flex-row sm:items-center sm:justify-between sm:px-8">
        <p>© {new Date().getFullYear()} Brais Fernández Reyes</p>
        <p class="font-mono tracking-wide">A CORUÑA · GALICIA</p>
      </div>
    </footer>
  </body>
</html>