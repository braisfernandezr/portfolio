---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Backend & Cloud Engineer | Portfolio">
  <!-- Section Hero -->
  <section class="py-12 md:py-20 flex flex-col items-start gap-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-mono">
      <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
      Ingeniero Informático
    </div>

    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-100 leading-tight">
      Especializado en <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-blue-600">Desarrollo Backend</span> y Arquitecturas Cloud.
    </h1>

    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">
      Apasionado por el diseño de sistemas distribuidos, la infraestructura como código, la automatización de despliegues y la observabilidad.
    </p>

    <div class="flex flex-wrap gap-4 pt-2">
      <a href="#proyectos" class="px-5 py-2.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-sm transition-all shadow-lg shadow-sky-500/20">
        Ver Proyectos
      </a>
      <a href="#contacto" class="px-5 py-2.5 rounded-lg border border-slate-700 hover:border-slate-500 text-slate-300 font-medium text-sm transition-all">
        Contactar
      </a>
    </div>
  </section>

  <!-- Section Tech Stack -->
  <section class="py-8 border-y border-slate-800/60 my-8">
    <h2 class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-4">Tecnologías & Herramientas</h2>
    <div class="flex flex-wrap gap-2 text-xs font-mono">
      {["Java / Spring Boot", "Python / Django", "Go", "Docker", "Ansible", "Vagrant", "PostgreSQL", "MongoDB", "MinIO", "Prometheus / Grafana", "Linux"].map((tech) => (
        <span class="px-3 py-1.5 rounded-md bg-slate-900 border border-slate-800 text-slate-300">
          {tech}
        </span>
      ))}
    </div>
  </section>

  <!-- Section Proyectos Destacados -->
  <section id="proyectos" class="py-12 space-y-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-200">Proyectos Destacados</h2>
    
    <div class="grid grid-cols-1 gap-6">
      <!-- Tarjeta de Proyecto 1 -->
      <article class="p-6 rounded-xl bg-slate-900/50 border border-slate-800/80 hover:border-slate-700 transition-all flex flex-col justify-between gap-4">
        <div>
          <div class="flex items-center justify-between gap-4 mb-2">
            <h3 class="text-lg font-bold text-slate-100">Sistema de Observabilidad & Almacenamiento Distribuido</h3>
            <span class="text-xs font-mono text-sky-400 bg-sky-500/10 px-2.5 py-1 rounded">Open Source</span>
          </div>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Infraestructura automatizada mediante Ansible y Vagrant desplegando servicios de almacenamiento S3-compatible con MinIO y monitorización completa con pila LGTM (Grafana, Loki, Tempo, Prometheus).
          </p>
        </div>
        <div class="flex items-center gap-3 text-xs font-mono text-slate-500">
          <span>Docker</span> • <span>Ansible</span> • <span>MinIO</span> • <span>Grafana</span>
        </div>
      </article>
    </div>
  </section>
</Layout>